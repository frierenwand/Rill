{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rill",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Migrations are bundled and applied by the Worker itself on first start.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"] }],
  // No database_id: Cloudflare provisions the D1 database automatically on deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "rill", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  // Optional secrets (Settings -> Variables and Secrets): RILL_SECRET to override the
  // auto-generated signing key, TMDB_KEY for a server-wide TMDB key. Do not put them here.
  "vars": {}
}
